- content_for :title, 'Positions'
= render layout: 'layouts/positions', locals: { nav_item: 'manage' } do
  .mb-3
    = render layout: 'umts/brand/card' do |card|
      - card.heading 'Manage Positions'
      - card.nav_items do
        - if allowed_to?(:new?, Position)
          = link_to new_position_path, class: 'nav-link' do
            %i.fa-solid.fa-plus
            New
      - card.body do
        - if @positions.present?
          .list-group.list-group-flush
            - @positions.each do |position|
              = link_to position.name, position_path(position), class: 'list-group-item list-group-item-action'
        - else
          .card-body
            No positions found
  = paginate @positions
