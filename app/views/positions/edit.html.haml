- content_for :title, "Edit #{@position.name_was}"
= render layout: 'layouts/position', object: @position, locals: { nav_item: 'settings' } do
  = render layout: 'umts/brand/card' do |card|
    - card.heading 'Edit Position'
    - card.body do
      .card-body
        = form_with model: @position, html: { id: 'position-form' } do |f|
          = render partial: 'fields', object: f
        .row.g-3
          .col
            .d-grid
              = button_tag type: :submit, form: 'position-form', class: 'btn btn-primary' do
                %i.fa-solid.fa-save
                Save
          - if allowed_to?(:destroy?, @position)
            .col
              .d-grid
                = button_to position_path(@position),
                            method: :delete,
                            class: 'btn btn-neutral',
                            form_class: 'd-grid',
                            'data-confirm': 'Are you sure? This cannot be undone.' do
                  %i.fa-solid.fa-trash
                  Delete
