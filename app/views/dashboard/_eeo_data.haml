.container
  = form_tag eeo_data_application_submissions_path, method: :get do
    .mb-3
      %h5.mb-2 List EEO data for
      = select_tag :department_ids,
                   options_from_collection_for_select(departments, :id, :name),
                   class: 'dept-select',
                   id: 'eeo-data-dept-select',
                   multiple: true
    .row.g-3
      .mb-3.col-md-6
        = label_tag :eeo_start_date, 'start date', class: 'form-label'
        = date_field_tag :eeo_start_date, '',
                         class: 'form-control', required: true
      .mb-3.col-md-6
        = label_tag :eeo_end_date, 'end date', class: 'form-label'
        = date_field_tag :eeo_end_date, '',
                         class: 'form-control', required: true
    .mb-2= submit_tag 'List EEO data', class: 'btn btn-primary'
