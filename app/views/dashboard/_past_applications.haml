.dashboard-partial
  .container
    = form_tag past_applications_application_submissions_path,
               method: :get do
      .mb-3
        %h5.mb-2 List applications for
        = select_tag :department_ids,
                     options_from_collection_for_select(departments, :id, :name),
                     class: 'dept-select',
                     id: 'past-applications-dept-select',
                     multiple: true
      .row.g-3
        .mb-3.col-md-6
          = label_tag :records_start_date, 'start date', class: 'form-label'
          = date_field_tag :records_start_date, '',
                           required: true, class: 'form-control'
        .mb-3.col-md-6
          = label_tag :records_end_date, 'end date', class: 'form-label'
          = date_field_tag :records_end_date, '',
                           required: true, class: 'form-control'
      .mb-2= submit_tag 'List Applications', class: 'btn btn-primary'
