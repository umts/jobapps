:ruby
  user_classes = {
    'Admins' => User.where(admin: true),
    'Staff' => User.where(admin: false, staff: true).distinct,
    'Applicants' => User.where(admin: false, staff: false).distinct
  }.compact_blank!
= render layout: 'layouts/resource', locals: { heading: 'Development Login' } do
  .card.mb-3
    .card-header Select user
    .card-body
      - user_classes.each do |name, users|
        .mb-3
          = form_with url: main_app.auth_callback_path(provider: 'developer'), method: :get, namespace: name do |f|
            = f.label :uid, name, class: 'form-label'
            .input-group
              = f.collection_select :uid, users, :entra_uid, :full_name, { include_blank: false }, class: 'form-select'
              = f.submit 'Log in', class: 'btn btn-neutral'
      %div
        = form_with url: main_app.azure_login_path do |f|
          = f.label :azure, class: 'form-label'
          .input-group
            = text_field_tag :azure, 'Yourself', readonly: true, class: 'form-control'
            = f.submit 'Log in', class: 'btn btn-neutral'
