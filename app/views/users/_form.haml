= form_for user,
           url: { controller: :users, action: action, id: user.id } do |f|
  .form-group
    = f.label :first_name
    = f.text_field :first_name, required: true, class: 'form-control'
  .form-group
    = f.label :last_name
    = f.text_field :last_name, required: true, class: 'form-control'
  .form-group
    = f.label :email
    = f.text_field :email, required: true, class: 'form-control'
  .form-group
    = f.label :entra_uid
    = f.text_field :entra_uid, required: true, class: 'form-control'
  .form-group
    = f.hidden_field :staff, value: true
    = f.submit 'Save changes', class: 'btn btn-primary'
