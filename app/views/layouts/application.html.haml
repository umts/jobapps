!!!
%html
  %head
    %title
      - if content_for?(:title)
        = yield :title
        &bull;
      Transit Job Applications &bull; UMass Amherst
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    = umts_brand_favicons
    = stylesheet_link_tag 'application.css', media: 'all'
    = javascript_include_tag 'application_legacy.js'
    = javascript_include_tag 'application.js', type: :module
  %body.min-vh-100.d-flex.flex-column.flex-nowrap.align-items-stretch.bg-primary
    %header
      = render partial: 'umts/brand/university_header',
               locals: { parent_department_name: 'Facilities & Campus Services',
                         parent_department_link: 'https://www.umass.edu/facilities',
                         department_name: 'Transit Services',
                         department_link: 'https://www.umass.edu/transportation' }
      = render partial: 'application/navbar'
    %main.bg-body.flex-grow-1
      .container.my-3
        = render partial: 'application/flash'
        = yield
    %footer
      = render partial: 'umts/brand/university_footer'
