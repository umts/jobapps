!!!
%html
  %head
    %title
      = "#{yield(:title)} -" if content_for?(:title)
      Transit Job Applications - UMass Amherst
    %meta{ name: 'viewport', content: 'width=device-width,initial-scale=1' }
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{ rel: 'icon', href: '/icon.png', type: 'image/png' }
    %link{ rel: 'icon', href: '/icon.svg', type: 'image/svg+xml' }
    %link{ rel: 'apple-touch-icon', href: '/icon.png' }
    = stylesheet_link_tag 'application.css', media: 'all'
    = javascript_include_tag 'application_legacy.js'
    = javascript_include_tag 'application.js', type: :module
  %body.min-vh-100.d-flex.flex-column.flex-nowrap.align-items-stretch.bg-primary
    %header
      = render partial: 'application/university_header'
      = render partial: 'application/navbar'
    %main.bg-body.flex-grow-1
      .container.my-3
        = render partial: 'application/flash'
        = yield
    %footer
      = render partial: 'application/university_footer'
